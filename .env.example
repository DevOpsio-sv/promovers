# Public site configuration. Copy to .env before a production build.
# These values are visible in the browser. Do not put secrets here.

# Canonical origin. Use the real workers.dev URL first, then https://promovers.bg.
VITE_SITE_URL=https://example.workers.dev

# Cloudflare Turnstile site key. The default in code is Cloudflare's public test key.
# Replace it for production. The matching secret belongs in Wrangler secrets, not here.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Leave blank until the real contact details exist. The site will not invent them.
VITE_PUBLIC_PHONE=
VITE_PUBLIC_EMAIL=

# Data controller placeholders for the privacy page.
VITE_DATA_CONTROLLER_NAME=
VITE_DATA_CONTROLLER_EMAIL=
VITE_DATA_CONTROLLER_ADDRESS=
VITE_DATA_CONTROLLER_ID=

# Keep false while the public URL is a workers.dev host.
# Set true only for the confirmed https://promovers.bg build.
VITE_INDEXING_ENABLED=false
